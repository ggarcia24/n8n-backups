    {
      "parameters": {
        "jsCode": "const config = $input.first().json;\nconst DAY_CONVERTER = 24 * 60 * 60 * 1000;\nconst todayDate = new Date();\n\nfunction formatDate(date) {\n  return date.toISOString().slice(0, 10)\n}\n\nfunction getMetricsForDate(date) {\n  // obisidian_property: endpoint\n  return [\n    {\n      date,\n      url: `measurements/check-in/${date}`,\n      mappings: {\n        weight: 'weight',\n        steps: 'steps',\n      },\n    },\n    {\n      date,\n      url: `food-entries/nutrition/today?date=${date}`,\n      mappings: {\n        calories: 'total_calories',\n        protein: 'total_protein',\n        carbs: 'total_carbs',\n        fat: 'total_fat',\n        fiber: 'total_dietary_fiber',\n      }\n    },\n    {\n      date,\n      url: `sleep?startDate=${date}&endDate=${date}`,\n      mappings: {\n        sleep: 'duration_in_seconds'\n      }\n    },\n    {\n      date,\n      url: `measurements/water-intake/${date}`,\n      mappings: {\n        water: 'waterIntake'\n      }\n    },\n  ];\n}\n\n\n\nif (!Number.isInteger(config.lookbackDays) || config.lookbackDays < 1 || config.lookbackDays > 31) {\n  throw new Error('lookbackDays must be an integer from 1 to 31.');\n}\n\n\nconst maxEndDate = config.endDateOverride || formatDate(new Date(Date.now() - config.lookbackDays * DAY_CONVERTER));\n\nconst todayRequests = getMetricsForDate(formatDate(todayDate));\n\nlet daysRequest = [];\nfor (let index = 1; index < config.lookbackDays; index++) {\n  const theDate = formatDate(new Date(todayDate - (index * DAY_CONVERTER)));\n  if (maxEndDate == theDate) {\n    break;\n  }\n  const newDayRequest = getMetricsForDate(\n    theDate\n  )\n  console.log(newDayRequest);\n  daysRequest = daysRequest.concat(newDayRequest)\n  console.log(daysRequest)\n}\n\nreturn todayRequests.concat(daysRequest);"
      },
