    {
      "parameters": {
        "jsCode": "\nreturn (function verifyWrites() {\n  const expected = $('Write enabled?').all(0);\n  const actual = $input.all();\n  if (expected.length !== actual.length) throw new Error('Unexpected number of verification responses.');\n  return actual.map((item, index) => {\n    const plan = expected[index].json;\n    if (item.json.statusCode !== 200 || item.json.body !== plan.proposedContent) {\n      throw new Error(`${plan.path}: read-back differs from the submitted note. Inspect for concurrent/Seafile edits; nothing will be overwritten again in this run.`);\n    }\n    return { json: { date: plan.date, path: plan.path, action: plan.action,\n      verified: true, fields: plan.fields, issues: plan.issues } };\n  });\n})();"
      },
      "id": "0deaed75-e34b-423d-a69e-526e19a4c754",
      "name": "Verify persisted content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3312,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "const days = {};\n\nfor (const item of $input.all()) {\n  const theDay = ''.concat(item.json.date);\n  const dayParts = theDay.split('-');\n\n  if (days[theDay] == undefined) {\n    days[theDay] = {\n      date: theDay,\n      year: dayParts[0],\n      month: dayParts[1],\n      day: dayParts[2],\n      updates: {},\n    };\n  }\n  console.log(theDay)\n  const mappingsKeys = Object.keys(item.json.mappings)\n  console.log(mappingsKeys);\n  for(const key of mappingsKeys) {\n    console.log(key)\n    const responseProperty = item.json.mappings[key];\n    console.log(responseProperty);\n    days[theDay].updates[key] = item.json.response[responseProperty]\n  }\n}\n\nreturn Object.values(days);"
      },
