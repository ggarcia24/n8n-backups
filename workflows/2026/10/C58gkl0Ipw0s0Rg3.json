        "jsCode": "\nreturn (function previewResults() {\n  return $input.all().map(item => {\n    const { date, path, action, fields, changes, issues, managedBlock, config } = item.json;\n    return { json: { date, path, action, previewOnly: config.previewOnly, fields, changes, issues,\n      managedBlock, note: ['update', 'create'].includes(action)\n        ? 'Preview only: no note has been written.' : 'No write required.' } };\n  });\n})();"
