      {
        "parameters": {
          "jsCode": "const regex = /^(?<name>.+)\\s(?<price>[0-9\\,]+)\\s(?<kind>AW|B|A)/;\nconst ticketText = $input.first().json.text;\n\nconst start = ticketText.indexOf(\"EUR\");\nconst end = ticketText.indexOf(\"Posten:\");\n\nconst rawText = ticketText.slice(start+3, end).trim();\n\nconst products = [];\n\nfor (const line of rawText.split(\"\\n\")) {\n  const matches = line.match(regex);\n  if (matches) {\n    const {name, price, kind} = matches.groups;\n    const product = {\n      name,\n      price,\n      kind,\n    }\n    products.push(product)\n  }\n}\nreturn {\n  rawText,\n  products,\n}\n"
